# これは見本です。実際の値は .env に書きます（.env は git に入れません）。
# ツールの中で動く AI の提供元。既定は mock（模擬）で、キーがなくても全機能が動きます。
AI_PROVIDER=mock

# mock 以外（anthropic / openai_compatible / cloudflare_workers_ai）を使うときだけ設定します。
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
